+        row = {"success": True, "end": "done", "goals_reached": 6, "n_goals": 6, "collisions": 3,
+               "time_to_goal_s": 60, "timeout_s": 200}
+        self.assertEqual(analysis.METRICS["route_complete"][0](row), 1)
