@@ -0,0 +1,24 @@
+"""Bounded newline-JSON protocol on a private loopback connection."""
+import json
+
+MAX_MESSAGE_BYTES = 4 * 1024 * 1024
+
+
+def send(stream, message):
+    payload = json.dumps(message, allow_nan=False).encode() + b"\n"
+    if len(payload) > MAX_MESSAGE_BYTES:
+        raise ValueError("E3 bridge message too large")
+    stream.write(payload)
+    stream.flush()
+
+
+def receive(stream):
+    payload = stream.readline(MAX_MESSAGE_BYTES + 1)
+    if not payload:
+        raise ConnectionError("Isaac bridge closed before its result")
+    if len(payload) > MAX_MESSAGE_BYTES or not payload.endswith(b"\n"):
+        raise ValueError("Invalid or oversized E3 bridge message")
+    message = json.loads(payload)
+    if not isinstance(message, dict):
+        raise ValueError("E3 bridge expects an object")
+    return message
