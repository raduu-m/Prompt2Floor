diff --git a/scripts/e3_suite.py b/scripts/e3_suite.py
new file mode 100644
index 0000000..38ce89e
--- /dev/null
+++ b/scripts/e3_suite.py
@@ -0,0 +1,194 @@
+"""Run a frozen E3 scene selection, verify complete paired trials, then analyze.
+
+    uv run python scripts/e3_suite.py results/e3_scene_selection/selection.json --out out/e3_suite
+
+The selection is an input, never replaced by a scene that happens to run. Failed
+scenes remain in suite.json. Analysis runs only when every selected scene passes.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+from importlib import metadata
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+TIERS = {"easy": ("base", 1), "medium": ("base", 3), "hard": ("hard", 6)}
+POLICIES = ("blind", "fields", "aware")
+
+
+def policy_preflight() -> dict:
+    sys.path.insert(0, str(ROOT / "src"))
+    from worldc.e3.sim import policy_provenance
+
+    provenance = policy_provenance()
+    if (not provenance["e3_policies_commit"] or not provenance["code_commit"]
+            or provenance["policies_changed_since_tag"]):
+        raise ValueError("Frozen policy provenance is unavailable or changed. Restore the documented policy tag "
+                         "and matching policy files before running the suite.")
+    return provenance
+
+
+def load_selection(path: Path, project: Path = ROOT) -> list[dict]:
+    selection = json.loads(path.read_text(encoding="utf-8"))
+    chosen = selection.get("chosen", [])
+    if not chosen or len(chosen) != selection.get("n", len(chosen)):
+        raise ValueError("selection must contain the requested number of scenes")
+    seen = set()
+    rows = []
+    for source in chosen:
+        label = source.get("prompt", "")
+        if not re.fullmatch(r"P[0-9]+", label) or label in seen:
+            raise ValueError(f"invalid or duplicate prompt label: {label!r}")
+        seen.add(label)
+        scene = Path(source["scene"])
+        if not scene.is_absolute():
+            scene = project / scene
+        scene = scene.resolve()
+        if not (scene / "resolved_spec.json").is_file():
+            raise ValueError(f"{label}: missing resolved_spec.json in {scene}")
+        rows.append({**source, "scene": str(scene),
+                     "resolved_spec_sha256": hashlib.sha256((scene / "resolved_spec.json").read_bytes()).hexdigest()})
+    return rows
+
+
+def verify_trials(path: Path, scene: str, seeds: int) -> dict:
+    """Reject missing/duplicate cells, mixed provenance, or invalid measurements."""
+    with path.open(newline="", encoding="utf-8") as handle:
+        rows = list(csv.DictReader(handle))
+    expected = {(t, str(s), p) for t in TIERS for s in range(seeds) for p in POLICIES}
+    seen = set()
+    provenance = set()
+    for row in rows:
+        key = (row["tier"], row["seed"], row["policy"])
+        if key in seen or key not in expected or row["scene"] != scene:
+            raise ValueError(f"{scene}: duplicate or unexpected trial {key}")
+        seen.add(key)
+        variant, workers = TIERS[row["tier"]]
+        if row["variant"] != variant or int(row["workers"]) != workers:
+            raise ValueError(f"{scene}: wrong variant or worker count in {key}")
+        if row["policies_at_tag"] != "True" or not row["e3_policies_commit"] or not row["code_commit"]:
+            raise ValueError(f"{scene}: frozen policy provenance is not verified")
+        provenance.add(tuple(row[k] for k in ("e3_policies", "e3_policies_commit", "code_commit")))
+        moving, stationary, total = (int(row[k]) for k in
+                                     ("collisions_robot_moving", "collisions_robot_stationary", "collisions"))
+        if min(moving, stationary, total) < 0 or moving + stationary != total:
+            raise ValueError(f"{scene}: inconsistent collision split in {key}")
+        reached, goals = int(row["goals_reached"]), int(row["n_goals"])
+        if goals < 1 or not 0 <= reached <= goals:
+            raise ValueError(f"{scene}: invalid goal counts in {key}")
+        success = row["success"] == "True"
+        complete = row["end"] == "done" and reached == goals
+        if success != (complete and moving == 0) or success != (row["outcome"] == "success"):
+            raise ValueError(f"{scene}: inconsistent success definition in {key}")
+    if seen != expected:
+        raise ValueError(f"{scene}: missing {len(expected - seen)} paired trials")
+    if len(provenance) != 1:
+        raise ValueError(f"{scene}: mixed code or policy versions")
+    replay = json.loads(path.with_name("replay.json").read_text(encoding="utf-8"))
+    if (replay.get("identical") is not True or not replay.get("digest")
+            or replay["digest"] != replay.get("replay_digest") or replay.get("tier") != "hard"
+            or replay.get("policy") != "blind" or replay.get("seed") not in range(seeds)):
+        raise ValueError(f"{scene}: deterministic replay did not pass")
+    tag, policy_commit, code_commit = provenance.pop()
+    return {"trials": len(rows), "e3_policies": tag, "e3_policies_commit": policy_commit, "code_commit": code_commit,
+            "replay": replay}
+
+
+def run_suite(selection: Path, out: Path, seeds: int, boot: int, no_gif: bool = True) -> int:
+    if seeds < 1 or boot < 1:
+        raise ValueError("seeds and bootstrap replicates must be positive")
+    chosen = load_selection(selection)
+    if out.exists() and any(out.iterdir()):
+        raise ValueError("output directory must be empty; choose a new path to preserve prior runs")
+    provenance = policy_preflight()
+    out.mkdir(parents=True, exist_ok=True)
+    versions = {}
+    for package in ("numpy", "scipy", "usd-core", "pydantic", "pillow"):
+        try:
+            versions[package] = metadata.version(package)
+        except metadata.PackageNotFoundError:
+            versions[package] = None
+    manifest = {"selection": str(selection.resolve()), "selected": chosen, "seeds": seeds,
+                "policy_preflight": provenance,
+                "implementation_sha256": {str(path.relative_to(ROOT)): hashlib.sha256(path.read_bytes()).hexdigest()
+                                          for path in [ROOT / "scripts/e3_suite.py", ROOT / "scripts/e3_one_scene.py",
+                                                       ROOT / "scripts/e3_analysis.py", *sorted((ROOT / "src/worldc/e3").glob("*.py"))]},
+                "environment": {"python": sys.version, "platform": sys.platform, "packages": versions},
+                "planned_scenes": len(chosen), "planned_trials": len(chosen) * seeds * 9,
+                "completed_scenes": 0, "verified_trials": 0, "scenes": [], "analysis": "not_run", "status": "running"}
+    def save():
+        (out / "suite.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")
+    save()
+    trials = []
+    provenances = set()
+    for item in chosen:
+        name = item["prompt"]
+        scene_out = out / name
+        scene_out.mkdir()
+        command = [sys.executable, str(ROOT / "scripts/e3_one_scene.py"), item["scene"],
+                   "--name", name, "--seeds", str(seeds), "--out", str(scene_out)]
+        if no_gif:
+            command.append("--no-gif")
+        result = {"prompt": name, "source_scene": item["scene"], "command": command, "status": "failed"}
+        print(f"Running {name}: {seeds * 9} planned trials", flush=True)
+        try:
+            with (scene_out / "run.log").open("w", encoding="utf-8") as log:
+                process = subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
+            if process.returncode:
+                raise ValueError(f"scene runner exited {process.returncode}; see {scene_out / 'run.log'}")
+            trial_path = scene_out / "trials.csv"
+            verified = verify_trials(trial_path, name, seeds)
+            if any(verified[k] != provenance[k] for k in ("e3_policies", "e3_policies_commit", "code_commit")):
+                raise ValueError(f"{name}: code or policy provenance changed after suite preflight")
+            result.update(status="complete", **verified)
+            provenances.add(tuple(verified[k] for k in ("e3_policies", "e3_policies_commit", "code_commit")))
+            trials.append(trial_path)
+            manifest["completed_scenes"] += 1
+            manifest["verified_trials"] += verified["trials"]
+        except (OSError, ValueError, KeyError) as error:
+            result["error"] = str(error)
+            print(f"FAILED {name}: {error}", flush=True)
+        manifest["scenes"].append(result)
+        save()
+    if manifest["completed_scenes"] != len(chosen) or len(provenances) != 1:
+        manifest["status"] = "failed"
+        manifest["error"] = "Selected scenes failed validation or code/policy versions differ; analysis was not run."
+        save()
+        return 1
+    command = [sys.executable, str(ROOT / "scripts/e3_analysis.py"), *map(str, trials),
+               "--out", str(out / "analysis"), "--boot", str(boot)]
+    manifest["analysis_command"] = command
+    try:
+        with (out / "analysis.log").open("w", encoding="utf-8") as log:
+            process = subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
+        manifest["analysis"] = "complete" if process.returncode == 0 else "failed"
+    except OSError as error:
+        manifest["analysis"] = "failed"
+        manifest["error"] = str(error)
+    manifest["status"] = manifest["analysis"]
+    save()
+    return 0 if manifest["status"] == "complete" else 1
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("selection", type=Path)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--seeds", type=int, default=10)
+    parser.add_argument("--boot", type=int, default=2000)
+    parser.add_argument("--gif", action="store_true", help="also generate diagnostic animations")
+    args = parser.parse_args()
+    try:
+        return run_suite(args.selection.resolve(), args.out.resolve(), args.seeds, args.boot, not args.gif)
+    except (OSError, ValueError, KeyError) as error:
+        parser.exit(1, f"E3 suite: {error}\n")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
