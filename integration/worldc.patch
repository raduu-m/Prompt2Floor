@@ -0,0 +1,47 @@
+"""Feedback port must reproduce frozen policies when its plant is the ideal unicycle."""
+import math
+import numpy as np
+import pytest
+
+from worldc.e3 import sim as S
+from worldc.e3.feedback import FeedbackTrial
+from worldc.e3.world import World
+from test_e3 import room
+
+
+def ideal_feedback(world, humans, policy, timeout=None):
+    trial = FeedbackTrial(world, policy, humans.shape[1], timeout=timeout)
+    x, y, yaw = world.spawn
+    th, v, w = S.wrap(yaw + world.phi0), 0.0, 0.0
+    for k in range(len(humans)):
+        command = trial.observe(k*S.DT, x, y, th-world.phi0, v, w, humans[k])
+        if command is None:
+            return trial.result()
+        v, w = command
+        th = S.wrap(th+w*S.DT)
+        x, y = x+v*math.cos(th)*S.DT, y+v*math.sin(th)*S.DT
+    raise AssertionError("Test human track too short")
+
+
+@pytest.mark.parametrize("policy", S.POLICIES)
+@pytest.mark.parametrize("xy", [(0,-0.6),(0,-1.5),(-1.9,0)])
+def test_feedback_matches_frozen_reference(room, policy, xy):
+    humans = np.tile(np.array([[*xy]],float),(4000,1,1))
+    reference = S.run_trial(room, humans, policy)
+    feedback = ideal_feedback(room, humans, policy)
+    assert feedback == reference
+
+
+@pytest.mark.parametrize("policy", S.POLICIES)
+def test_feedback_align_and_rear_approach_match(room, policy):
+    world = World("turn",room.xr,room.yr,room.res,{},[],(-3,0,np.pi),room.robot,room.robot_r,
+                  [{"id":"g","pose":(3,0,np.pi)}],room.raw_pois)
+    humans = np.zeros((4000,1,2))
+    humans[:,0,0] = np.minimum(-3.9+1.8*S.DT*np.arange(len(humans)),3.9)
+    assert ideal_feedback(world,humans,policy) == S.run_trial(world,humans,policy)
+
+
+def test_feedback_rejects_unsynchronized_observations(room):
+    trial = FeedbackTrial(room,"blind",1)
+    with pytest.raises(ValueError,match="clock"):
+        trial.observe(1.0,-3,0,0,0,0,[[0,1]])
