+"""Standalone orchestration checks: python tests/test_e3_suite.py (no Isaac required)."""
+from __future__ import annotations
+
+import csv
+import importlib.util
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+from types import SimpleNamespace
+
+ROOT = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location("e3_suite", ROOT / "scripts/e3_suite.py")
+suite = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(suite)
+
+
+def write_trials(out, name="P18", seeds=1):
+    out.mkdir(parents=True, exist_ok=True)
+    rows = []
+    for tier, (variant, workers) in suite.TIERS.items():
+        for seed in range(seeds):
+            for policy in suite.POLICIES:
+                rows.append({"scene": name, "tier": tier, "variant": variant, "workers": workers, "seed": seed,
+                             "policy": policy, "policies_at_tag": True, "e3_policies": "e3-policies-v1",
+                             "e3_policies_commit": "policy123", "code_commit": "code123", "collisions_robot_moving": 0,
+                             "collisions_robot_stationary": 1, "collisions": 1, "goals_reached": 2, "n_goals": 2,
+                             "end": "done", "success": True, "outcome": "success"})
+    save_rows(out / "trials.csv", rows)
+    (out / "replay.json").write_text(json.dumps({"identical": True, "digest": "abc", "replay_digest": "abc",
+                                               "tier": "hard", "policy": "blind", "seed": 0}))
+    return rows
+
+
+def save_rows(path, rows):
+    with path.open("w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+
+
+class SuiteTests(unittest.TestCase):
+    def setUp(self):
+        self.preflight = patch.object(suite, "policy_preflight", return_value={"e3_policies": "e3-policies-v1",
+                                     "e3_policies_commit": "policy123", "code_commit": "code123"})
+        self.preflight.start()
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+        self.scene = self.root / "scene"
+        self.scene.mkdir()
+        (self.scene / "resolved_spec.json").write_text("{}")
+        self.selection = self.root / "selection.json"
+        self.selection.write_text(json.dumps({"n": 1, "chosen": [{"prompt": "P18", "scene": str(self.scene)}]}))
+
+    def tearDown(self):
+        self.preflight.stop()
+        self.tmp.cleanup()
+
+    def test_selection_rejects_duplicate_labels_and_missing_scenes(self):
+        row = {"prompt": "P18", "scene": str(self.scene)}
+        self.selection.write_text(json.dumps({"n": 2, "chosen": [row, row]}))
+        with self.assertRaisesRegex(ValueError, "duplicate"):
+            suite.load_selection(self.selection)
+        self.selection.write_text(json.dumps({"chosen": [{"prompt": "P19", "scene": "missing"}]}))
+        with self.assertRaisesRegex(ValueError, "missing resolved"):
+            suite.load_selection(self.selection, self.root)
+
+    def test_complete_grid_and_stationary_contact_success_are_valid(self):
+        write_trials(self.root)
+        self.assertEqual(suite.verify_trials(self.root / "trials.csv", "P18", 1)["trials"], 9)
+
+    def test_rejects_missing_duplicate_and_mixed_version_trials(self):
+        path = self.root / "trials.csv"
+        rows = write_trials(self.root)
+        save_rows(path, rows[:-1])
+        with self.assertRaisesRegex(ValueError, "missing"):
+            suite.verify_trials(path, "P18", 1)
+        save_rows(path, rows + [rows[0]])
+        with self.assertRaisesRegex(ValueError, "duplicate"):
+            suite.verify_trials(path, "P18", 1)
+        rows[-1]["code_commit"] = "different"
+        save_rows(path, rows)
+        with self.assertRaisesRegex(ValueError, "mixed"):
+            suite.verify_trials(path, "P18", 1)
+
+    def test_rejects_false_success_and_replay_failure(self):
+        rows = write_trials(self.root)
+        rows[0].update(collisions_robot_moving=1, collisions_robot_stationary=0)
+        save_rows(self.root / "trials.csv", rows)
+        with self.assertRaisesRegex(ValueError, "success definition"):
+            suite.verify_trials(self.root / "trials.csv", "P18", 1)
+        write_trials(self.root)
+        (self.root / "replay.json").write_text('{"identical": false}')
+        with self.assertRaisesRegex(ValueError, "replay"):
+            suite.verify_trials(self.root / "trials.csv", "P18", 1)
+
+    def test_unverified_policy_rows_are_rejected(self):
+        rows = write_trials(self.root)
+        rows[0]["policies_at_tag"] = False
+        save_rows(self.root / "trials.csv", rows)
+        with self.assertRaisesRegex(ValueError, "provenance"):
+            suite.verify_trials(self.root / "trials.csv", "P18", 1)
+
+    def test_failed_preflight_does_not_launch_or_create_output(self):
+        out = self.root / "not_started"
+        self.preflight.stop()
+        with patch.object(suite, "policy_preflight", side_effect=ValueError("policy changed")):
+            with patch.object(suite.subprocess, "run") as run:
+                with self.assertRaisesRegex(ValueError, "policy changed"):
+                    suite.run_suite(self.selection, out, 1, 10)
+        run.assert_not_called()
+        self.assertFalse(out.exists())
+
+    def test_batch_only_analyzes_verified_outputs(self):
+        out = self.root / "run"
+        calls = []
+        def execute(command, **kwargs):
+            calls.append(command)
+            if "e3_one_scene.py" in command[1]:
+                write_trials(Path(command[command.index("--out") + 1]))
+            return SimpleNamespace(returncode=0)
+        with patch.object(suite.subprocess, "run", side_effect=execute):
+            self.assertEqual(suite.run_suite(self.selection, out, 1, 10), 0)
+        receipt = json.loads((out / "suite.json").read_text())
+        self.assertEqual(receipt["verified_trials"], 9)
+        self.assertEqual(receipt["status"], "complete")
+        self.assertEqual(len(calls), 2)
+        with self.assertRaisesRegex(ValueError, "empty"):
+            suite.run_suite(self.selection, out, 1, 10)
+
+    def test_failed_scene_is_recorded_and_analysis_is_not_run(self):
+        out = self.root / "failed"
+        with patch.object(suite.subprocess, "run", return_value=SimpleNamespace(returncode=2)) as run:
+            self.assertEqual(suite.run_suite(self.selection, out, 1, 10), 1)
+        receipt = json.loads((out / "suite.json").read_text())
+        self.assertEqual(run.call_count, 1)
+        self.assertEqual(receipt["planned_trials"], 9)
+        self.assertEqual(receipt["analysis"], "not_run")
+        self.assertEqual(receipt["scenes"][0]["status"], "failed")
+
+
+if __name__ == "__main__":
+    unittest.main()
