+++ b/tests/test_e3_contact.py
@@ -0,0 +1,44 @@
+import pytest
+from worldc.e3.contact import ContactEpisodes
+
+
+def test_contacts_need_impulse_and_recontact_counts_once():
+    count = ContactEpisodes("/Robot", ["/Floor"])
+    pair = ["/Robot/wheel", "/Human"]
+    assert not count.observe("found", pair, 0.0, True)["new_physical_episode"]
+    assert count.observe("persist", pair, 0.01, True)["new_physical_episode"]
+    assert not count.observe("persist", pair, 1, False)["new_physical_episode"]
+    count.observe("lost", pair, 0, False)
+    assert count.observe("found", pair, 0.1, False)["new_physical_episode"]
+    assert count.summary()["physx_contact_episodes"] == 2
+    assert count.summary()["physx_moving_contact_episodes"] == 1
+    assert count.summary()["physx_stationary_contact_episodes"] == 1
+
+
+def test_floor_and_similar_prefix_are_not_hazard_contacts():
+    count = ContactEpisodes("/Robot", ["/Floor"])
+    assert count.observe("found", ["/Robot/wheel", "/Floor/mesh"], 1, True) is None
+    assert count.observe("found", ["/RobotOther", "/Human"], 1, True) is None
+    assert count.summary()["physx_floor_reports"] == 1
+    assert count.summary()["physx_contact_episodes"] == 0
+def test_native_callback_serializes_numpy_motion_state():
+    import io
+    import json
+    from types import SimpleNamespace
+    import numpy as np
+    from worldc.e3.contact import ContactEpisodes, NativeContactRecorder
+
+    recorder = NativeContactRecorder.__new__(NativeContactRecorder)
+    recorder.counter = ContactEpisodes('/Robot', ['/Floor'])
+    recorder.observation = lambda: {'t': np.float64(0.05), 'moving': np.bool_(True)}
+    recorder.errors, recorder.stream = [], io.StringIO()
+    recorder.decode, recorder.names = str, {1: 'found'}
+    header = SimpleNamespace(collider0='/Robot/wheel', collider1='/Human', contact_data_offset=0, num_contact_data=1, type=1)
+    recorder.callback([header], [SimpleNamespace(impulse=(0.1, 0, 0))])
+    assert not recorder.errors
+    assert json.loads(recorder.stream.getvalue())['moving'] is True
+    lost = SimpleNamespace(collider0='/Robot/wheel', collider1='/Human', contact_data_offset=0, num_contact_data=0, type=2)
+    recorder.names[2] = 'lost'
+    recorder.callback([lost,header], [SimpleNamespace(impulse=(0.1,0,0))])
+    assert recorder.summary()['physx_contact_episodes']==1
