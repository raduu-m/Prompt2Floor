new file mode 100644
index 0000000..f120ad4
--- /dev/null
+++ b/src/worldc/e3/contact.py
@@ -0,0 +1,97 @@
+"""Impulse-confirmed PhysX contact episodes; no Isaac imports at module load."""
+from __future__ import annotations
+
+import json
+import math
+
+IMPULSE_THRESHOLD_NS = 1e-5
+
+
+def under(path, parent):
+    return path == parent or path.startswith(parent + "/")
+
+
+class ContactEpisodes:
+    def __init__(self, robot, floors):
+        self.robot, self.floors = robot, tuple(floors)
+        self.active, self.confirmed = set(), set()
+        self.floor_reports = self.raw_begins = self.physical_begins = 0
+        self.moving_begins = self.stationary_begins = 0
+
+    def observe(self, event, paths, impulse, moving):
+        if not any(under(path, self.robot) for path in paths):
+            return None
+        if all(under(path, self.robot) for path in paths):
+            return None
+        if any(under(path, floor) for path in paths for floor in self.floors):
+            self.floor_reports += 1
+            return None
+        key = tuple(sorted(paths))
+        if event == "lost":
+            self.active.discard(key)
+            self.confirmed.discard(key)
+            return {"new_physical_episode": False, "event": event}
+        if event not in ("found", "persist"):
+            raise ValueError(f"Unknown contact event {event}")
+        if key not in self.active:
+            self.active.add(key)
+            self.raw_begins += 1
+        new = impulse > IMPULSE_THRESHOLD_NS and key not in self.confirmed
+        if new:
+            self.confirmed.add(key)
+            self.physical_begins += 1
+            self.moving_begins += bool(moving)
+            self.stationary_begins += not bool(moving)
+        return {"new_physical_episode": new, "event": event}
+
+    def summary(self):
+        return {"physx_contact_episodes": self.physical_begins,
+                "physx_moving_contact_episodes": self.moving_begins,
+                "physx_stationary_contact_episodes": self.stationary_begins,
+                "physx_report_begins": self.raw_begins, "physx_floor_reports": self.floor_reports}
+
+
+class NativeContactRecorder:
+    def __init__(self, path, robot, floors, observation):
+        import omni.physx
+        from pxr import PhysicsSchemaTools
+        from omni.physx.bindings._physx import ContactEventType
+
+        self.counter = ContactEpisodes(robot, floors)
+        self.observation = observation
+        self.errors = []
+        self.stream = path.open("w", encoding="utf-8")
+        self.decode = PhysicsSchemaTools.intToSdfPath
+        self.names = {ContactEventType.CONTACT_FOUND: "found", ContactEventType.CONTACT_LOST: "lost",
+                      ContactEventType.CONTACT_PERSIST: "persist"}
+        self.subscription = omni.physx.get_physx_simulation_interface().subscribe_contact_report_events(self.callback)
+
+    def callback(self, headers, data):
+        try:
+            state = self.observation()
+            grouped = {}
+            for header in headers:
+                paths = [str(self.decode(header.collider0)), str(self.decode(header.collider1))]
+                contacts = data[header.contact_data_offset:header.contact_data_offset + header.num_contact_data]
+                impulse = max([math.sqrt(sum(float(v)**2 for v in contact.impulse)) for contact in contacts] or [0.0])
+                grouped.setdefault(tuple(sorted(paths)),[]).append((self.names[header.type],impulse))
+            for paths,reports in grouped.items():
+                # A mesh may report a lost contact patch and a persisting one in
+                # the same physics callback. Separation requires every patch lost.
+                live = [r for r in reports if r[0] != "lost"]
+                event = "persist" if live else "lost"
+                impulse = max([r[1] for r in live] or [0.0])
+                result = self.counter.observe(event, paths, impulse, state["moving"])
+                if result and (result["new_physical_episode"] or result["event"] in ("found", "lost")):
+                    self.stream.write(json.dumps({**result, "paths": paths, "t": float(state["t"]), "moving": bool(state["moving"]),
+                                                  "maximum_impulse_Ns": impulse}) + "\n")
+            self.stream.flush()
+        except Exception as error:
+            self.errors.append(f"{type(error).__name__}: {error}")
+
+    def close(self):
+        self.subscription = None
+        self.stream.close()
+
+    def summary(self):
+        return {**self.counter.summary(), "contact_callback_errors": list(self.errors)}
