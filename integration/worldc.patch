+"""Minimal Kit startup shared by the contact probe and E3 physical trials."""
+from pathlib import Path
+
+
+def start_app():
+    import torch  # noqa: F401 -- Windows Kit DLL initialization order.
+    import isaacsim
+    from isaacsim import SimulationApp
+
+    package = Path(isaacsim.__file__).parent
+    extra = [arg for name in ("exts", "extscache", "extsPhysics") if (package/name).is_dir()
+             for arg in ("--ext-folder", str(package/name))]
+    extra += ["--enable", "isaacsim.core.api", "--enable", "isaacsim.core.prims"]
+    return SimulationApp({"headless": True, "multi_gpu": False, "extra_args": extra}, experience=str(Path(__file__).with_name("e3_isaac.kit")))
+
+
+def physics_step(simulation, dt):
+    """Step PhysX explicitly and verify its callback clock, including Isaac 4.5.
+
+    Isaac 4.5's SimulationManager may have an empty scene registry when opening
+    an existing stage; its get_physics_dt then silently returns 1/60. Passing
+    dt to PhysX avoids that fallback without mutating private manager state.
+    """
+    import omni.physx
+    physics = omni.physx.get_physx_simulation_interface()
+    before = simulation.current_time
+    physics.simulate(dt, before)
+    physics.fetch_results()
+    measured = simulation.current_time-before
+    if abs(measured-dt) > 1e-7:
+        raise RuntimeError(f"PhysX callback time step mismatch: expected {dt}, measured {measured}")
