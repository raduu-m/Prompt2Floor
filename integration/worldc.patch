+"""Isaac-only measured plant for E3. Launch with Kit's Python, not host Python.
+
+No host USD, SciPy, or pydantic dependencies are injected into this process.
+Robot motion uses articulated wheel velocity targets; only scripted humans
+receive kinematic pose targets. Never replays a saved robot trajectory.
+"""
+from __future__ import annotations
+
+import argparse
+import importlib.metadata
+import json
+import math
+from pathlib import Path
+import socket
+import time
+import traceback
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("trial", type=Path)
+    parser.add_argument("--port", required=True, type=int)
+    parser.add_argument("--token", required=True)
+    args = parser.parse_args()
+    trial = json.loads(args.trial.read_text())
+    out = Path(trial["out"])
+    from worldc.render.e3_boot import start_app, physics_step
+    app = start_app()
+    conn = None
+    recorder = None
+    try:
+        import numpy as np
+        import omni.usd
+        import omni.physics.tensors as tensors
+        from pxr import Gf, Usd, UsdGeom, UsdPhysics, PhysxSchema
+        from isaacsim.core.api import SimulationContext
+        from worldc.e3.contact import NativeContactRecorder
+        from worldc.e3.wire import send, receive
+
+        dt = float(trial["physics_dt"])
+        control_dt = float(trial["control_dt"])
+        substeps = round(control_dt/dt)
+        if abs(substeps*dt-control_dt) > 1e-10:
+            raise ValueError("Control period must be an integer number of physics steps")
+        H = np.load(trial["human_track"])["human_xy"]
+        graph = json.loads((Path(trial["scene_dir"])/"scene_graph.json").read_text())
+        context = omni.usd.get_context()
+        context.open_stage(str(Path(trial["scene_dir"])/graph.get("usd", "scene.usd")))
+        began = time.monotonic()
+        while context.get_stage_loading_status()[2] > 0:
+            if time.monotonic()-began > 120:
+                raise TimeoutError("Isaac scene assets did not finish loading")
+            app.update()
+        for _ in range(10):
+            app.update()
+        stage = context.get_stage()
+        robot_path = graph["robot"]["prim"]
+        root_prim = stage.GetPrimAtPath(robot_path)
+        if not root_prim:
+            raise RuntimeError("Scene has no real robot prim")
+        # Physics overrides must reach instance proxies throughout the stage:
+        # robot links need reports and environment visuals must not collide.
+        while True:
+            instances = [p for p in stage.Traverse() if p.IsInstance()]
+            if not instances:
+                break
+            for prim in instances:
+                prim.SetInstanceable(False)
+        articulation = next((prim for prim in Usd.PrimRange(root_prim, Usd.TraverseInstanceProxies())
+                             if prim.HasAPI(UsdPhysics.ArticulationRootAPI)), None)
+        if articulation is None:
+            raise RuntimeError("Robot articulation did not load; no proxy or kinematic robot fallback is permitted")
+        floors, contact_bodies = [], []
+        disabled_visual_colliders = 0
+        for prim in stage.Traverse():
+            if not (str(prim.GetPath()) == robot_path or str(prim.GetPath()).startswith(robot_path+"/")):
+                if prim.HasAPI(UsdPhysics.RigidBodyAPI):
+                    body = UsdPhysics.RigidBodyAPI(prim)
+                    if "/Visual" in str(prim.GetPath()):
+                        body.CreateRigidBodyEnabledAttr(False)
+                        prim.RemoveAPI(UsdPhysics.RigidBodyAPI)
+                    else:
+                        body.CreateKinematicEnabledAttr(True)
+                if prim.HasAPI(UsdPhysics.ArticulationRootAPI):
+                    prim.RemoveAPI(UsdPhysics.ArticulationRootAPI)
+                if prim.IsA(UsdPhysics.Joint):
+                    UsdPhysics.Joint(prim).CreateJointEnabledAttr(False)
+                if "/Visual" in str(prim.GetPath()) and prim.HasAPI(UsdPhysics.CollisionAPI):
+                    UsdPhysics.CollisionAPI(prim).CreateCollisionEnabledAttr(False)
+                    disabled_visual_colliders += 1
+            for namespace in ("scene", "warehouse", "plant"):
+                attr = prim.GetAttribute(namespace+":category")
+                if attr and attr.Get() == "floor":
+                    floors.append(str(prim.GetPath()))
+            if str(prim.GetPath()).startswith(robot_path+"/") and prim.HasAPI(UsdPhysics.RigidBodyAPI):
+                PhysxSchema.PhysxContactReportAPI.Apply(prim).CreateThresholdAttr(0.0)
+                contact_bodies.append(str(prim.GetPath()))
+        if not floors:
+            raise RuntimeError("Could not identify the floor for contact filtering")
+        if not contact_bodies:
+            raise RuntimeError("No robot rigid bodies available for contact reporting")
+        remaining = [str(p.GetPath()) for p in stage.Traverse()
+                     if not str(p.GetPath()).startswith(robot_path+"/") and "/Visual" in str(p.GetPath())
+                     and p.HasAPI(UsdPhysics.CollisionAPI)
+                     and UsdPhysics.CollisionAPI(p).GetCollisionEnabledAttr().Get()]
+        setup = {"disabled_visual_colliders":disabled_visual_colliders,"remaining_enabled_visual_colliders":remaining,
+                 "contact_bodies":contact_bodies,"floor_paths":floors}
+        (out/"native_setup.json").write_text(json.dumps(setup,indent=2),encoding="utf-8")
+        if remaining:
+            raise RuntimeError("Inherited visual colliders remain enabled")
+        human_paths = []
+        radius, height = 0.26, 1.775
+        for i in range(trial["workers"]):
+            path = f"/World/E3Workers/worker_{i}"
+            capsule = UsdGeom.Capsule.Define(stage, path)
+            capsule.CreateRadiusAttr(radius)
+            capsule.CreateHeightAttr(height-2*radius)
+            capsule.CreateAxisAttr("Z")
+            UsdGeom.Xformable(capsule.GetPrim()).AddTranslateOp().Set(Gf.Vec3d(0, 0, -20))
+            UsdPhysics.CollisionAPI.Apply(capsule.GetPrim())
+            body = UsdPhysics.RigidBodyAPI.Apply(capsule.GetPrim())
+            body.CreateKinematicEnabledAttr(True)
+            UsdPhysics.MassAPI.Apply(capsule.GetPrim()).CreateMassAttr(70.0)
+            human_paths.append(path)
+        physics_scenes = [p for p in stage.Traverse() if p.IsA(UsdPhysics.Scene)]
+        if len(physics_scenes) != 1:
+            raise RuntimeError(f"Expected one authored PhysicsScene, found {len(physics_scenes)}")
+        simulation = SimulationContext(physics_dt=dt, rendering_dt=1/60, stage_units_in_meters=1.0, backend="numpy",
+                                       physics_prim_path=str(physics_scenes[0].GetPath()))
+        simulation.initialize_physics()
+        simulation.play()
+        physics_step(simulation, dt)
+        sv = tensors.create_simulation_view("numpy")
+        robot = sv.create_articulation_view(str(articulation.GetPath()))
+        humans = sv.create_rigid_body_view(human_paths)
+        names = list(robot.shared_metatype.dof_names)
+        left = [names.index(name) for name in trial["drive"]["left"]]
+        right = [names.index(name) for name in trial["drive"]["right"]]
+        index = np.array([0], np.int32)
+        human_indices = np.arange(len(human_paths), dtype=np.int32)
+        count = len(names)
+
+        def yaw(q):
+            return math.atan2(2*(q[3]*q[2]+q[0]*q[1]), 1-2*(q[1]*q[1]+q[2]*q[2]))
+
+        def wrap(angle):
+            return (angle+math.pi) % (2*math.pi)-math.pi
+
+        def wheel_step(wl=0.0, wr=0.0):
+            targets = np.zeros((1, count), np.float32)
+            targets[0, left], targets[0, right] = wl, wr
+            robot.set_dof_velocity_targets(targets, index)
+            physics_step(simulation, dt)
+
+        # Calibrate the real articulation, then reset its full state before t=0.
+        for _ in range(round(1/dt)):
+            wheel_step()
+        initial_root = np.array(robot.get_root_transforms(), copy=True)
+        initial_joints = np.array(robot.get_dof_positions(), copy=True)
+        for k in range(round(0.9/dt)):
+            wheel_step(4, 4)
+            if k == round(0.45/dt):
+                first = np.array(robot.get_root_transforms()[0], copy=True)
+        last = np.array(robot.get_root_transforms()[0], copy=True)
+        duration = (round(0.9/dt)-round(0.45/dt))*dt
+        forward = float(np.linalg.norm(last[:2]-first[:2]))/duration/4
+        phi = wrap(math.atan2(last[1]-first[1], last[0]-first[0])-yaw(last[3:]))
+        for _ in range(round(0.6/dt)):
+            wheel_step()
+        for k in range(round(0.9/dt)):
+            wheel_step(-4, 4)
+            if k == round(0.45/dt):
+                first_yaw = yaw(robot.get_root_transforms()[0, 3:])
+        turn = wrap(yaw(robot.get_root_transforms()[0, 3:])-first_yaw)/duration/4
+        if forward < 0.01 or abs(turn) < 0.01:
+            raise RuntimeError("Real wheel calibration failed")
+        calibration = {"forward_m_per_s_per_rad_s": forward, "turn_rad_s_per_rad_s": turn,
+                       "travel_heading_in_robot_frame_rad": phi}
+        robot.set_root_transforms(initial_root, index)
+        robot.set_root_velocities(np.zeros((1,6), np.float32), index)
+        robot.set_dof_positions(initial_joints, index)
+        robot.set_dof_velocities(np.zeros((1,count), np.float32), index)
+        for _ in range(12):
+            wheel_step()
+        pose = robot.get_root_transforms()[0]
+        if np.linalg.norm(pose[:2]-initial_root[0,:2]) > 0.05 or abs(wrap(yaw(pose[3:])-yaw(initial_root[0,3:]))) > 0.05:
+            raise RuntimeError("Robot did not reset to its episode spawn after calibration")
+        elapsed = 0.0
+        moving = False
+        recorder = NativeContactRecorder(out/"physx_contacts.jsonl", robot_path, floors,
+                                         lambda: {"t": elapsed, "moving": moving})
+
+        def human_targets(at, reset=False):
+            s = min(at/control_dt, len(H)-1.000001)
+            i, u = int(s), s-int(s)
+            xy = (1-u)*H[i]+u*H[i+1]
+            poses = np.zeros((len(H[0]),7), np.float32)
+            poses[:,:2], poses[:,2], poses[:,6] = xy, height/2, 1
+            if reset:
+                humans.set_transforms(poses, human_indices)
+            humans.set_kinematic_targets(poses, human_indices)
+
+        # Place initial poses without sweeping capsules upward from their
+        # construction position below the floor. Later updates remain targets.
+        human_targets(0, reset=True)
+        wheel_step()
+        start_time = simulation.current_time
+        conn = socket.create_connection(("127.0.0.1", args.port), timeout=30)
+        conn.settimeout(180)
+        high_rate = []
+        max_tilt, min_z = 0.0, math.inf
+        with conn.makefile("rwb") as stream:
+            send(stream, {"type": "ready", "token": args.token, "isaac_version": importlib.metadata.version("isaacsim"),
+                          "calibration": calibration, "contact_bodies": contact_bodies, "floor_paths": floors})
+            step = 0
+            while True:
+                elapsed = step*control_dt
+                pose = np.asarray(robot.get_root_transforms()[0], float)
+                velocity = np.asarray(robot.get_root_velocities()[0], float)
+                body_yaw = yaw(pose[3:])
+                heading = body_yaw+phi
+                v = float(velocity[0]*math.cos(heading)+velocity[1]*math.sin(heading))
+                w = float(velocity[5])
+                moving = abs(v)>0.05 or abs(w)>0.2
+                tilt = math.degrees(math.acos(float(np.clip(1-2*(pose[3]**2+pose[4]**2),-1,1))))
+                max_tilt, min_z = max(max_tilt,tilt), min(min_z,float(pose[2]))
+                failure = tilt>20 or pose[2]<-0.1
+                send(stream, {"type": "observation", "t": elapsed, "physics_time": simulation.current_time-start_time,
+                              "robot": [float(pose[0]),float(pose[1]),body_yaw,v,w],
+                              "humans": np.asarray(humans.get_transforms()[:,:2],float).tolist(), "physics_failure": bool(failure)})
+                command = receive(stream)
+                if command.get("type")!="command":
+                    raise RuntimeError("Invalid controller response")
+                if command["done"]:
+                    summary = {**recorder.summary(), "max_tilt_deg": max_tilt, "min_z_m": min_z,
+                               "physics_steps": len(high_rate), "physics_dt": dt,
+                               "contact_bodies": contact_bodies, "floor_paths": floors}
+                    (out/"physics_summary.json").write_text(json.dumps(summary,indent=2),encoding="utf-8")
+                    np.savez_compressed(out/"physics_trace.npz", robot=np.asarray(high_rate,float))
+                    send(stream,{"type":"finished","physics":summary})
+                    break
+                wl = float(command["v"])/forward-float(command["w"])/turn
+                wr = float(command["v"])/forward+float(command["w"])/turn
+                for j in range(substeps):
+                    elapsed = step*control_dt+(j+1)*dt
+                    human_targets(elapsed)
+                    before = np.asarray(robot.get_root_velocities()[0],float)
+                    moving = np.linalg.norm(before[:2])>0.05 or abs(before[5])>0.2
+                    wheel_step(wl,wr)
+                    measured = np.asarray(robot.get_root_transforms()[0],float)
+                    high_rate.append([elapsed,*measured.tolist()])
+                step += 1
+    except Exception:
+        details = traceback.format_exc()
+        (out/"native_error.txt").write_text(details,encoding="utf-8")
+        if conn is not None:
+            try:
+                from worldc.e3.wire import send
+                with conn.makefile("rwb") as stream:
+                    send(stream,{"type":"error","error":details[-3000:]})
+            except Exception:
+                pass
+        raise
+    finally:
+        if recorder is not None:
+            recorder.close()
+        if conn is not None:
+            conn.close()
+        app.close()
+
+
+if __name__ == "__main__":
+    main()
