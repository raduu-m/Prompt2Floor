index 0000000..e92d24f
--- /dev/null
+++ b/src/worldc/render/e3_isaac_probe.py
@@ -0,0 +1,87 @@
+"""A required native contact-delivery diagnostic, not a navigation trial."""
+import importlib.metadata
+import json
+from pathlib import Path
+import sys
+import traceback
+
+
+def main():
+    out = Path(sys.argv[1])
+    out.mkdir(parents=True, exist_ok=True)
+    from worldc.render.e3_boot import start_app, physics_step
+    app = start_app()
+    recorder = None
+    result = {"passed": False, "navigation_trials": 0}
+    try:
+        import numpy as np
+        import omni.usd
+        import omni.physics.tensors as tensors
+        from pxr import Gf, UsdGeom, UsdPhysics, PhysxSchema
+        from isaacsim.core.api import SimulationContext
+        from worldc.e3.contact import NativeContactRecorder
+
+        context = omni.usd.get_context()
+        context.new_stage()
+        stage = context.get_stage()
+        def box(path, position, size, dynamic=False):
+            cube = UsdGeom.Cube.Define(stage, path)
+            cube.CreateSizeAttr(1.0)
+            transform = UsdGeom.Xformable(cube.GetPrim())
+            transform.AddTranslateOp().Set(Gf.Vec3d(*position))
+            transform.AddScaleOp().Set(Gf.Vec3f(*size))
+            UsdPhysics.CollisionAPI.Apply(cube.GetPrim())
+            if dynamic:
+                UsdPhysics.RigidBodyAPI.Apply(cube.GetPrim())
+                mass = UsdPhysics.MassAPI.Apply(cube.GetPrim())
+                mass.CreateMassAttr(80)
+                PhysxSchema.PhysxContactReportAPI.Apply(cube.GetPrim()).CreateThresholdAttr(0)
+            return cube
+        box("/World/Floor", (0,0,-0.1), (20,10,0.2))
+        box("/World/Wall", (2,0,1), (0.2,4,2))
+        box("/World/Robot", (0,0,0.3), (0.5,0.5,0.5), True)
+        sim = SimulationContext(physics_dt=1/120, rendering_dt=1/60, stage_units_in_meters=1.0, backend="numpy")
+        sim.initialize_physics()
+        sim.play()
+        physics_step(sim, 1/120)
+        simulation_view = tensors.create_simulation_view("numpy")
+        view = simulation_view.create_rigid_body_view("/World/Robot")
+        t = 0.0
+        moving = False
+        recorder = NativeContactRecorder(out/"contacts.jsonl", "/World/Robot", ["/World/Floor"], lambda:{"t":t,"moving":moving})
+        stages = []
+        def drive(name, speed, seconds):
+            nonlocal t, moving
+            for _ in range(round(seconds*120)):
+                moving = abs(speed)>0.05
+                view.set_velocities(np.array([[speed,0,0,0,0,0]],np.float32), np.array([0],np.int32))
+                physics_step(sim, 1/120)
+                t += 1/120
+            x = float(view.get_transforms()[0,0])
+            stages.append({"name":name,"robot_x":x,"wall_gap_m":1.9-(x+0.25), **recorder.summary()})
+        drive("floor_only",0,0.5)
+        floor_control = recorder.summary()["physx_contact_episodes"] == 0
+        drive("first_hold",1,3)
+        drive("first_retreat",-1,2)
+        drive("second_hold",1,4)
+        drive("second_retreat",-1,2)
+        summary = recorder.summary()
+        near = all(abs(s["wall_gap_m"])<0.06 for s in stages if s["name"].endswith("hold"))
+        away = all(s["wall_gap_m"]>0.3 for s in stages if s["name"].endswith("retreat"))
+        result.update(isaac_version=importlib.metadata.version("isaacsim"), contacts=summary, stages=stages,
+                      floor_control=floor_control, near=near, away=away,
+                      passed=bool(floor_control and near and away and summary["physx_floor_reports"]>0
+                                  and summary["physx_contact_episodes"]==2 and not summary["contact_callback_errors"]))
+    except Exception:
+        result["error"] = traceback.format_exc()
+    finally:
+        if recorder is not None:
+            recorder.close()
+        (out/"probe.json").write_text(json.dumps(result,indent=2),encoding="utf-8")
+        app.close()
+    if not result["passed"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
