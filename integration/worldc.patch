+"""Closed-loop E3 controller/metrics for an observed plant, version isaac-e3-v1.
+
+The frozen 2D simulator remains the reference. This port uses its constants,
+planners, footprint distances and policy helpers without modifying sim.py.
+The caller supplies measured poses/velocities; no robot integration occurs here.
+"""
+from __future__ import annotations
+
+import math
+import numpy as np
+
+from . import sim as S
+from .world import plan
+
+BACKEND = "isaac-physx-e3-v1"
+
+
+class FeedbackTrial:
+    def __init__(self, world, policy, people, legs=None, timeout=None):
+        if policy not in S.POLICIES:
+            raise ValueError(f"Unknown policy {policy}")
+        self.world, self.policy = world, policy
+        self.legs = S.static_legs(world) if legs is None else legs
+        self.timeout = S.timeout_s(world, self.legs) if timeout is None else timeout
+        self.leg, self.state, self.state_t = 0, "drive", 0.0
+        self.path = S.Path(self.legs[0]) if self.legs and self.legs[0] is not None else None
+        self.s_prog = 0.0
+        self.clear_since, self.holding = None, False
+        self.next_aware = self.next_replan = 0.0
+        self.replans = 0
+        self.hold_s = self.warning_s = 0.0
+        self.in_prot, self.protective_stops = False, 0
+        self.in_contact = np.zeros(people, bool)
+        self.collisions = self.moving_hits = self.moving_behind = self.moving_braking = 0
+        self.min_gap = self.min_gap_moving = math.inf
+        self.near = {b: 0.0 for b in S.NEAR_BANDS}
+        self.near_moving = {b: 0.0 for b in S.MOVING_BANDS}
+        self.stationary_s = self.stationary_near_s = self.hh_overlap = 0.0
+        self.trajectory, self.events, self.arrivals = [], [], []
+        self.prog_t, self.prog_xy = 0.0, world.spawn[:2]
+        self.end, self.t, self.k = None, 0.0, 0
+        self.v_cmd = self.w_cmd = 0.0
+
+    def observe(self, t, x, y, body_yaw, v, w, humans):
+        """Return (commanded forward m/s, yaw rad/s), or None when finished."""
+        if self.end is not None:
+            return None
+        expected = self.k * S.DT
+        if abs(t - expected) > 1e-5:
+            raise ValueError(f"Observation clock {t} differs from E3 control clock {expected}")
+        self.t, self.k = t, self.k + 1
+        H = np.asarray(humans, float).reshape(-1, 2)
+        if H.shape[0] != len(self.in_contact) or not np.isfinite([x, y, body_yaw, v, w]).all() or not np.isfinite(H).all():
+            raise ValueError("Invalid measured robot/human state")
+        if self.k - 1 >= int(self.timeout / S.DT):
+            self.end = "timeout"
+            return None
+        world, g = self.world, self.world.grid
+        th = S.wrap(body_yaw + world.phi0)
+        moving = abs(v) > S.MOVING_V or abs(w) > S.MOVING_W
+        gp = S.gaps(x, y, body_yaw, world.body_half, H)[0]
+        if not moving:
+            self.stationary_s += S.DT
+            self.stationary_near_s += S.DT * bool(len(gp) and gp.min() < S.STATIONARY_NEAR_M)
+        if len(gp):
+            ahead = math.cos(th) * (H[:, 0] - x) + math.sin(th) * (H[:, 1] - y)
+            gap = float(gp.min())
+            self.min_gap = min(self.min_gap, gap)
+            for b in self.near:
+                self.near[b] += S.DT * (gap < b)
+            if moving:
+                self.min_gap_moving = min(self.min_gap_moving, gap)
+                for b in self.near_moving:
+                    self.near_moving[b] += S.DT * (gap < b)
+            hit = gp <= 0.0
+            for i in np.flatnonzero(hit & ~self.in_contact):
+                self.collisions += 1
+                self.moving_hits += moving
+                self.moving_behind += int(moving and ahead[i] < 0)
+                self.moving_braking += int(moving and self.holding)
+                self.events.append({"type": "collision", "t": round(t, 2), "worker": int(i), "xy": [round(x, 2), round(y, 2)],
+                                    "robot_v": round(v, 2), "robot_w": round(w, 2), "robot_moving": bool(moving),
+                                    "ahead_x": round(float(ahead[i]), 2), "from_behind": bool(ahead[i] < 0),
+                                    "robot_holding": bool(self.holding), "state": self.state})
+            self.in_contact = hit
+            if len(H) > 1:
+                dd = np.hypot(*(H[:, None, :] - H[None, :, :]).transpose(2, 0, 1))
+                self.hh_overlap += S.DT * float((dd[np.triu_indices(len(H), 1)] < 2 * S.HUMAN_RADIUS_M).any())
+        if (self.k - 1) % 4 == 0:
+            self.trajectory.append([round(t, 2), round(x, 3), round(y, 3), round(th, 3), round(v, 3)])
+        if self.leg >= len(self.legs):
+            self.end = "done"
+            return None
+        if self.path is None:
+            self.end = "goal_unreachable"
+            return None
+        if (self.state == "drive" or (self.state == "align" and self.holding)) and math.hypot(x - self.prog_xy[0], y - self.prog_xy[1]) <= S.FROZEN_M:
+            if t - self.prog_t > S.FROZEN_S:
+                self.end = "frozen"
+                return None
+        else:
+            self.prog_t, self.prog_xy = t, (x, y)
+        gx, gy, gyaw = world.goals[self.leg]["pose"]
+        scale = 1.0
+        if self.policy == "fields" and self.state in ("drive", "align") and len(gp):
+            prot, warn = S.in_fields(world, x, y, th, v, w, H)
+            if prot.any():
+                self.protective_stops += not self.in_prot
+                self.holding, self.clear_since = True, None
+            elif self.holding:
+                self.clear_since = t if self.clear_since is None else self.clear_since
+                self.holding = t - self.clear_since < S.FIELDS["resume_clear_s"]
+            self.in_prot = bool(prot.any())
+            if warn.any():
+                self.warning_s += S.DT
+                scale = S.FIELDS["warning_scale"]
+        if self.policy == "aware" and len(gp):
+            scale = float(np.clip((gp.min() - S.SLOW_NEAR_M) / (S.SLOW_FAR_M - S.SLOW_NEAR_M), 0.0, 1.0))
+            if self.state == "align":
+                self.holding = scale <= 0.0
+            if self.state == "drive" and t >= self.next_aware:
+                self.next_aware = t + 1.0 / S.AWARE_HZ
+                blocked = S._human_block(world, H)
+                ss = np.arange(self.s_prog, min(self.s_prog + S.AWARE_LOOKAHEAD_M, self.path.length), g.res)
+                if any(blocked[g.clamp(g.cell(*self.path.point_at(s)))] for s in ss):
+                    if t >= self.next_replan:
+                        free = g.free & ~blocked
+                        r0, c0 = g.clamp(g.cell(x, y))
+                        free[max(r0 - 3, 0):r0 + 4, max(c0 - 3, 0):c0 + 4] = g.free[max(r0 - 3, 0):r0 + 4, max(c0 - 3, 0):c0 + 4]
+                        p = plan(g, free, (x, y), (gx, gy))
+                        self.replans += 1
+                        if p is not None:
+                            self.path, self.s_prog, self.holding = S.Path(p), 0.0, False
+                        else:
+                            self.holding, self.next_replan = True, t + 1.0
+                else:
+                    self.holding = False
+        v_t = w_t = 0.0
+        if self.state == "drive":
+            self.s_prog = self.path.closest(x, y, self.s_prog)
+            distance = math.hypot(gx - x, gy - y)
+            tx, ty = self.path.point_at(min(self.s_prog + S.LOOK, self.path.length))
+            alpha = S.wrap(math.atan2(ty - y, tx - x) - th)
+            if distance < 0.3:
+                self.state, self.state_t = "align", t
+            elif self.holding:
+                self.hold_s += S.DT
+            elif abs(alpha) > 0.7:
+                w_t = scale * float(np.clip(2 * alpha, -S.WMAX, S.WMAX))
+            else:
+                v_t = scale * S.VMAX * float(np.clip(distance / 1.5, 0.25, 1.0)) * (1.0 - 0.6 * abs(alpha))
+                w_t = scale * float(np.clip(2 * v_t * math.sin(alpha) / S.LOOK + 0.8 * alpha, -S.WMAX, S.WMAX))
+        if self.state == "align":
+            error = S.wrap(gyaw - th)
+            if self.holding:
+                self.state_t += S.DT
+                self.hold_s += S.DT
+            else:
+                w_t = scale * float(np.clip(1.8 * error, -1, 1)) if abs(error) > S.YAW_TOL else 0.0
+            if not self.holding and (abs(error) <= S.YAW_TOL or t - self.state_t > S.ALIGN_MAX_S):
+                self.arrivals.append({"goal": world.goals[self.leg]["id"], "reached": math.hypot(gx-x, gy-y) < S.REACH_M, "t": round(t, 2)})
+                self.state, self.state_t = "pause", t
+        if self.state == "pause" and t - self.state_t > S.PAUSE_S:
+            self.leg += 1
+            self.state, self.s_prog, self.holding, self.clear_since = "drive", 0.0, False, None
+            if self.leg < len(self.legs):
+                self.path = S.Path(self.legs[self.leg]) if self.legs[self.leg] is not None else None
+                if self.path is not None and self.policy == "aware":
+                    self.path = S.Path(np.vstack([[x, y], self.legs[self.leg][1:]]))
+        dec = world.robot["brake_decel_mps2"] if self.policy == "fields" and self.holding else S.DEC_V
+        self.v_cmd += float(np.clip(v_t-self.v_cmd, -dec*S.DT, S.ACC_V*S.DT))
+        self.w_cmd += float(np.clip(w_t-self.w_cmd, -S.ACC_W*S.DT, S.ACC_W*S.DT))
+        return self.v_cmd, self.w_cmd
+
+    def result(self):
+        if self.end is None:
+            raise RuntimeError("Cannot score an unfinished feedback trial")
+        reached = all(a["reached"] for a in self.arrivals)
+        outcome = "success" if self.end == "done" and reached and not self.moving_hits else (
+            "collision" if self.moving_hits else "goal_missed" if self.end == "done" else self.end)
+        fin = lambda value: round(value, 3) if math.isfinite(value) else None
+        return {"policy": self.policy, "success": outcome == "success", "outcome": outcome, "end": self.end,
+                "frozen": self.end == "frozen", "collisions_robot_moving": self.moving_hits,
+                "collisions_robot_moving_from_behind": self.moving_behind, "collisions_robot_moving_braking": self.moving_braking,
+                "collisions": self.collisions, "collisions_robot_stationary": self.collisions-self.moving_hits,
+                "time_to_goal_s": round(self.t, 2) if self.end == "done" else None, "sim_s": round(self.t, 2),
+                "min_gap_m": fin(self.min_gap), "min_gap_moving_m": fin(self.min_gap_moving),
+                **{f"time_within_{b:g}m_s": round(v, 2) for b, v in self.near.items()},
+                **{f"time_within_{b:g}m_moving_s": round(v, 2) for b, v in self.near_moving.items()},
+                "stationary_s": round(self.stationary_s, 2), "stationary_near_1m_s": round(self.stationary_near_s, 2),
+                "human_human_overlap_s": round(self.hh_overlap, 2), "goals_reached": sum(a["reached"] for a in self.arrivals),
+                "n_goals": len(self.legs), "replans": self.replans, "hold_s": round(self.hold_s, 2),
+                "protective_stops": self.protective_stops, "field_warning_s": round(self.warning_s, 2),
+                "events": self.events, "arrivals": self.arrivals, "trajectory": self.trajectory}
