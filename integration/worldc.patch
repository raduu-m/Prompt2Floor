+"""Prepare and supervise the full E3 experiment with an isolated Isaac runtime.
+
+Host dependencies stay in worldc's environment. Kit receives only a JSON
+manifest, NumPy worker tracks, and the small contact/wire modules.
+"""
+from __future__ import annotations
+
+import csv
+from contextlib import contextmanager
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import secrets
+import socket
+import subprocess
+import sys
+import time
+
+import numpy as np
+
+from . import sim as S
+from .feedback import BACKEND, FeedbackTrial
+from .tiers import make_variants
+from .walkers import workers
+from .wire import send, receive
+from .world import load_world
+from ..assets import robots
+
+ROOT = Path(__file__).resolve().parents[3]
+PHYSICS_DT = 1 / 120
+TIERS = {"easy": ("base", 1), "medium": ("base", 3), "hard": ("hard", 6)}
+
+
+def write_json(path, content):
+    path.write_text(json.dumps(content, indent=2, allow_nan=False), encoding="utf-8")
+
+
+def script(name):
+    spec = importlib.util.spec_from_file_location(name, ROOT / "scripts" / f"{name}.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def prepare(selection, out, seeds=10, transform_seed=0):
+    if seeds < 1:
+        raise ValueError("seeds must be positive")
+    if out.exists() and any(out.iterdir()):
+        raise ValueError("Use a new empty experiment directory")
+    suite = script("e3_suite")
+    chosen = suite.load_selection(selection)
+    provenance = suite.policy_preflight()
+    out.mkdir(parents=True, exist_ok=True)
+    manifest = {"schema": "e3-isaac-experiment-v1", "backend": BACKEND, "status": "preparing",
+                "selection": str(selection.resolve()), "seeds": seeds, "selected": chosen,
+                "planned_trials": len(chosen)*seeds*9, "control_dt": S.DT, "physics_dt": PHYSICS_DT,
+                "transform_seed":transform_seed,
+                "observations": "perfect measured simulator state; no perception model",
+                "humans": "seeded nonreactive kinematic capsules, radius 0.26 m",
+                "policy_provenance": provenance, "scenes": [], "trials": [], "failures": [],
+                "implementation_sha256": {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest()
+                    for p in [*sorted((ROOT / "src/worldc").rglob("*.py")),
+                              ROOT/"src/worldc/assets/library/robots/isaac_5.1_robots.json",
+                              ROOT/"src/worldc/assets/library/catalog/simready_curated.json", ROOT/"uv.lock",
+                              ROOT/"scripts/e3_isaac_suite.py", ROOT/"scripts/e3_suite.py",
+                              ROOT/"src/worldc/render/e3_isaac_probe.py", ROOT/"src/worldc/render/e3_boot.py",
+                              ROOT/"src/worldc/render/e3_isaac.kit", ROOT/"scripts/e3_analysis.py",
+                              ROOT/"scripts/e3_isaac_analysis.py"]}}
+    for item in chosen:
+        label = item["prompt"]
+        destination = out / label
+        destination.mkdir()
+        try:
+            variants = make_variants(item["scene"], destination / "scenes", seed=transform_seed)
+            if not (variants["base"]["ok"] and variants["hard"]["ok"]):
+                raise ValueError(f"Variant checks failed: {variants}")
+            worlds = {variant: load_world(destination / "scenes" / variant / "scene") for variant in ("base", "hard")}
+            timeouts = {variant: S.timeout_s(world, S.static_legs(world)) for variant, world in worlds.items()}
+            timeout = max(timeouts.values())
+            scene_info = {**item, "status": "prepared", "timeout_s": timeout, "variants": variants}
+            manifest["scenes"].append(scene_info)
+            for tier, (variant, count) in TIERS.items():
+                world = worlds[variant]
+                scene_graph = destination/"scenes"/variant/"scene/scene_graph.json"
+                usd_name = json.loads(scene_graph.read_text()).get("usd","scene.usd")
+                drive = robots.DIFF_DRIVE.get(world.robot["asset"])
+                if drive is None:
+                    raise ValueError(f"No calibrated differential-drive mapping for {world.robot['asset']}")
+                for seed in range(seeds):
+                    H, info = workers(world, seed, count, timeout + 1, S.DT)
+                    track_path = destination / f"{tier}_seed{seed}.npz"
+                    np.savez_compressed(track_path, human_xy=H)
+                    workers_path = track_path.with_suffix(".json")
+                    write_json(workers_path, info)
+                    for policy in S.POLICIES:
+                        trial_id = f"{label}_{tier}_seed{seed}_{policy}"
+                        trial_dir = destination / trial_id
+                        trial_dir.mkdir()
+                        row = {"id": trial_id, "scene": label, "tier": tier, "variant": variant,
+                               "seed": seed, "policy": policy, "workers": count, "status": "pending",
+                               "scene_dir": str((destination / "scenes" / variant / "scene").resolve()),
+                               "out": str(trial_dir.resolve()), "human_track": str(track_path.resolve()),
+                               "workers_drawn": str(workers_path.resolve()),
+                               "scene_usd":usd_name,
+                               "human_track_sha256": hashlib.sha256(track_path.read_bytes()).hexdigest(),
+                               "scene_usd_sha256": hashlib.sha256((destination/"scenes"/variant/"scene"/usd_name).read_bytes()).hexdigest(),
+                               "scene_graph_sha256": hashlib.sha256((destination/"scenes"/variant/"scene/scene_graph.json").read_bytes()).hexdigest(),
+                               "timeout_s": timeout, "control_dt": S.DT, "physics_dt": PHYSICS_DT,
+                               "robot": world.robot, "drive": drive, "body_half": list(world.body_half),
+                               "impulse_threshold_Ns": 1e-5}
+                        write_json(trial_dir / "trial.json", row)
+                        manifest["trials"].append(row)
+        except Exception as error:
+            manifest["failures"].append({"scene": label, "error": f"{type(error).__name__}: {error}"})
+        write_json(out / "experiment.json", manifest)
+    manifest["status"] = "prepared" if not manifest["failures"] and len(manifest["trials"]) == manifest["planned_trials"] else "preparation_failed"
+    write_json(out / "experiment.json", manifest)
+    return manifest
+
+
+def runtime_version(python):
+    command = [str(python), "-c", "import importlib.metadata as m; print(m.version('isaacsim'))"]
+    result = subprocess.run(command, capture_output=True, text=True, timeout=30)
+    if result.returncode:
+        root_version = python.parent / "VERSION"
+        if root_version.is_file():
+            return root_version.read_text().strip()
+        raise RuntimeError(f"Cannot identify Isaac runtime: {result.stderr[-1000:]}")
+    return result.stdout.strip().splitlines()[-1]
+
+
+def check_runtime(python, allow_45=False):
+    if not python.is_file():
+        raise ValueError(f"Isaac interpreter does not exist: {python}")
+    version = runtime_version(python)
+    pair = tuple(int(part) for part in version.split(".")[:2])
+    minimum = (4, 5) if allow_45 else (5, 0)
+    if pair < minimum:
+        raise ValueError(f"Isaac Sim {version} is below {minimum}; an older engine must be explicitly selected as a separate backend")
+    return version
+
+
+def verify_trial_inputs(trial):
+    if hashlib.sha256(Path(trial["human_track"]).read_bytes()).hexdigest()!=trial["human_track_sha256"]:
+        raise ValueError("Seeded human track changed after preparation")
+    for filename,key in ((trial.get("scene_usd","scene.usd"),"scene_usd_sha256"),("scene_graph.json","scene_graph_sha256")):
+        if hashlib.sha256((Path(trial["scene_dir"])/filename).read_bytes()).hexdigest()!=trial[key]:
+            raise ValueError(f"Prepared scene changed: {filename}")
+
+
+def launch_trial(trial, native_python, boot_timeout=180, wall_timeout=900):
+    """One isolated physics process per trial; fail rather than reuse 2D motion."""
+    verify_trial_inputs(trial)
+    world = load_world(trial["scene_dir"])
+    control = FeedbackTrial(world, trial["policy"], trial["workers"], timeout=trial["timeout_s"])
+    destination = Path(trial["out"])
+    token = secrets.token_hex(24)
+    server = socket.socket()
+    server.bind(("127.0.0.1", 0))
+    server.listen(1)
+    server.settimeout(boot_timeout)
+    env = os.environ.copy()
+    env["PYTHONPATH"] = str(ROOT / "src")  # Never inject host usd-core/NumPy into Kit.
+    command = [str(native_python), "-m", "worldc.render.e3_isaac", str(destination / "trial.json"),
+               "--port", str(server.getsockname()[1]), "--token", token]
+    began = time.monotonic()
+    process = None
+    try:
+        with (destination / "native.log").open("w", encoding="utf-8") as log:
+            process = subprocess.Popen(command, env=env, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
+            server.settimeout(0.5)
+            while True:
+                try:
+                    conn, _ = server.accept()
+                    break
+                except socket.timeout:
+                    if process.poll() is not None:
+                        raise RuntimeError("Isaac exited before bridge initialization; see native_error.txt and native.log")
+                    if time.monotonic()-began > boot_timeout:
+                        raise TimeoutError("Isaac did not initialize before the boot deadline")
+            conn.settimeout(boot_timeout)
+            with conn, conn.makefile("rwb") as stream:
+                ready = receive(stream)
+                if ready.get("type") != "ready" or ready.get("token") != token:
+                    raise RuntimeError("Isaac bridge authentication/initialization failed")
+                world.robot["travel_heading_rad"] = ready["calibration"]["travel_heading_in_robot_frame_rad"]
+                while True:
+                    if time.monotonic()-began > wall_timeout:
+                        raise TimeoutError("Isaac trial exceeded the wall-clock budget")
+                    message = receive(stream)
+                    if message.get("type") == "error":
+                        raise RuntimeError(message.get("error", "Isaac worker failed"))
+                    if message.get("type") != "observation":
+                        raise RuntimeError(f"Unexpected bridge message {message.get('type')}")
+                    if abs(message["t"]-message["physics_time"]) > 1e-4:
+                        raise RuntimeError(f"Isaac physics and controller clocks diverged: controller={message['t']}, physics={message['physics_time']}")
+                    command_vw = control.observe(message["t"], *message["robot"], message["humans"])
+                    if message.get("physics_failure"):
+                        control.end = "physics_failure"
+                        command_vw = None
+                    send(stream, {"type": "command", "done": command_vw is None,
+                                  "v": command_vw[0] if command_vw else 0.0,
+                                  "w": command_vw[1] if command_vw else 0.0})
+                    if command_vw is None:
+                        final = receive(stream)
+                        if final.get("type") != "finished":
+                            raise RuntimeError("Isaac did not acknowledge the terminal command")
+                        break
+            remaining = max(1, wall_timeout-(time.monotonic()-began))
+            if process.wait(timeout=remaining):
+                raise RuntimeError("Isaac exited unsuccessfully; see native.log")
+        physics = final["physics"]
+        if physics["contact_callback_errors"] or physics["physx_floor_reports"] < 1:
+            raise RuntimeError("PhysX contact instrumentation failed its delivery check")
+        result = {**control.result(), **physics, "backend": BACKEND,
+                  "isaac_version": ready["isaac_version"], "calibration": ready["calibration"],
+                  "wall_s": round(time.monotonic()-began, 2)}
+        complete = result["end"] == "done" and result["goals_reached"] == result["n_goals"]
+        result["physx_success"] = complete and physics["physx_moving_contact_episodes"] == 0
+        result["physx_contact_free_success"] = complete and physics["physx_contact_episodes"] == 0
+        write_json(destination / "result.json", result)
+        return result
+    finally:
+        server.close()
+        if process is not None and process.poll() is None:
+            # Hard timeout or broken measurement bridge: do not leave Kit on the GPU.
+            if os.name == "nt":
+                subprocess.run(["taskkill", "/PID", str(process.pid), "/T", "/F"], capture_output=True)
+            else:
+                process.kill()
+            process.wait(timeout=30)
+
+
+def contact_probe(out, native_python):
+    attempt = len(list(out.glob("contact_probe_*")))+1
+    destination = out / f"contact_probe_{attempt}"
+    destination.mkdir()
+    env = os.environ.copy()
+    env["PYTHONPATH"] = str(ROOT/"src")
+    with (destination/"native.log").open("w",encoding="utf-8") as log:
+        process = subprocess.Popen([str(native_python),"-m","worldc.render.e3_isaac_probe",str(destination)],
+                                   env=env,stdin=subprocess.DEVNULL,stdout=log,stderr=subprocess.STDOUT)
+        try:
+            code = process.wait(timeout=300)
+        except subprocess.TimeoutExpired:
+            if os.name == "nt":
+                subprocess.run(["taskkill","/PID",str(process.pid),"/T","/F"],capture_output=True)
+            else:
+                process.kill()
+            process.wait(timeout=30)
+            raise TimeoutError("Isaac contact probe exceeded 300 seconds")
+    receipt_path = destination/"probe.json"
+    receipt = json.loads(receipt_path.read_text()) if receipt_path.is_file() else {}
+    if code or not receipt.get("passed"):
+        raise RuntimeError(f"Native contact probe did not pass; see {destination/'native.log'}")
+    return receipt
+
+
+def replay_check(first, repeated):
+    """Predeclared physical replay tolerance, never adjusted after outcomes."""
+    a, b = np.asarray(first["trajectory"],float), np.asarray(repeated["trajectory"],float)
+    if not len(a) or not len(b):
+        return {"passed":False,"reason":"missing measured trajectories"}
+    times = a[:,0][a[:,0] <= b[-1,0]]
+    bx = np.interp(times,b[:,0],b[:,1])
+    by = np.interp(times,b[:,0],b[:,2])
+    delta = float(np.hypot(a[:len(times),1]-bx,a[:len(times),2]-by).max())
+    angle = np.interp(times,b[:,0],np.unwrap(b[:,3]))
+    angle_error = float(np.abs((a[:len(times),3]-angle+np.pi)%(2*np.pi)-np.pi).max())
+    duration_error = abs(first["sim_s"]-repeated["sim_s"])
+    discrete = all(first[k]==repeated[k] for k in ("outcome","goals_reached","collisions_robot_moving","physx_contact_episodes"))
+    return {"passed":bool(discrete and delta<=0.01 and angle_error<=0.02 and duration_error<=0.1),
+            "maximum_xy_error_m":delta,"maximum_heading_error_rad":angle_error,"duration_error_s":duration_error,
+            "discrete_results_match":discrete,"xy_tolerance_m":0.01,"heading_tolerance_rad":0.02,"time_tolerance_s":0.1}
+
+
+@contextmanager
+def campaign_lock():
+    """Prevent concurrent native campaigns in this project; OS releases on crash."""
+    handle = (ROOT/".e3-isaac.lock").open("a+b")
+    try:
+        if handle.seek(0,2)==0:
+            handle.write(b"0")
+            handle.flush()
+        handle.seek(0)
+        if os.name=="nt":
+            import msvcrt
+            msvcrt.locking(handle.fileno(),msvcrt.LK_NBLCK,1)
+        else:
+            import fcntl
+            fcntl.flock(handle,fcntl.LOCK_EX|fcntl.LOCK_NB)
+        yield
+    finally:
+        handle.close()
+
+
+def execute(out, native_python, allow_45=False, resume=False):
+    with campaign_lock():
+        return _execute(out,native_python,allow_45,resume)
+
+
+def _execute(out, native_python, allow_45=False, resume=False):
+    manifest_path = out / "experiment.json"
+    manifest = json.loads(manifest_path.read_text())
+    permitted = ("prepared","runtime_blocked","instrumentation_blocked") + (("running","verifying") if resume else ())
+    if manifest["status"] not in permitted:
+        raise ValueError("Experiment must be completely prepared before physical trials")
+    for path,digest in manifest["implementation_sha256"].items():
+        if hashlib.sha256((ROOT/path).read_bytes()).hexdigest()!=digest:
+            raise ValueError(f"Implementation changed after preparation: {path}")
+    try:
+        version = check_runtime(native_python, allow_45)
+        if any(t["status"]=="complete" for t in manifest["trials"]) and manifest.get("isaac_version",version)!=version:
+            raise ValueError("Resume requires the same Isaac engine version")
+    except Exception as error:
+        manifest.update(status="runtime_blocked",error=str(error))
+        write_json(manifest_path,manifest)
+        return manifest
+    manifest.update(status="running", isaac_python=str(native_python), isaac_version=version)
+    write_json(manifest_path, manifest)
+    try:
+        manifest["contact_probe"] = contact_probe(out,native_python)
+    except Exception as error:
+        manifest.update(status="instrumentation_blocked",error=str(error))
+        write_json(manifest_path,manifest)
+        return manifest
+    rows = []
+    for trial in manifest["trials"]:
+        print(f"Isaac {trial['id']}", flush=True)
+        try:
+            verify_trial_inputs(trial)
+            if trial["status"]=="complete":
+                result_path = Path(trial["out"])/"result.json"
+                if hashlib.sha256(result_path.read_bytes()).hexdigest()!=trial.get("result_sha256"):
+                    raise ValueError("Completed trial result changed; resume is blocked")
+                result = json.loads(result_path.read_text())
+                for filename,digest in trial["evidence_sha256"].items():
+                    if hashlib.sha256((Path(trial["out"])/filename).read_bytes()).hexdigest()!=digest:
+                        raise ValueError(f"Completed native evidence changed: {filename}")
+            else:
+                destination = Path(trial["out"])
+                if (destination/"native.log").exists():
+                    # Interrupted native attempts remain evidence; resume uses a new directory.
+                    original = destination
+                    attempt = 1
+                    while (original/f"resume_attempt_{attempt}").exists():
+                        attempt += 1
+                    destination = original/f"resume_attempt_{attempt}"
+                    destination.mkdir()
+                    trial["out"] = str(destination)
+                    write_json(destination/"trial.json",trial)
+                result = launch_trial(trial, native_python)
+                trial["result_sha256"] = hashlib.sha256((destination/"result.json").read_bytes()).hexdigest()
+                trial["evidence_sha256"] = {name:hashlib.sha256((destination/name).read_bytes()).hexdigest()
+                    for name in ("native_setup.json","physics_summary.json","physics_trace.npz","physx_contacts.jsonl")}
+            row = {"scene": trial["scene"], "tier": trial["tier"], "variant": trial["variant"], "seed": trial["seed"],
+                   "workers": trial["workers"], "timeout_s": trial["timeout_s"],
+                   "e3_policies":manifest["policy_provenance"]["e3_policies"],
+                   "e3_policies_commit":manifest["policy_provenance"]["e3_policies_commit"],
+                   "code_commit":manifest["policy_provenance"]["code_commit"], "policies_at_tag":True,
+                   **{k: v for k, v in result.items() if k not in ("events", "arrivals", "trajectory", "calibration", "contact_callback_errors", "contact_bodies", "floor_paths")}}
+            rows.append(row)
+            trial["status"] = "complete"
+        except Exception as error:
+            trial.update(status="failed", error=f"{type(error).__name__}: {error}")
+            manifest["failures"].append({"trial": trial["id"], "error": trial["error"]})
+            # Infrastructure/measurement failure must not trigger hundreds of identical attempts.
+            write_json(manifest_path,manifest)
+            break
+        manifest["completed_trials"] = len(rows)
+        write_json(manifest_path, manifest)
+        with (out/"trials.csv").open("w",newline="",encoding="utf-8") as handle:
+            writer=csv.DictWriter(handle,fieldnames=list(rows[0]))
+            writer.writeheader()
+            writer.writerows(rows)
+    if rows:
+        with (out / "trials.csv").open("w", newline="", encoding="utf-8") as handle:
+            writer = csv.DictWriter(handle, fieldnames=list(rows[0]))
+            writer.writeheader()
+            writer.writerows(rows)
+    manifest["completed_trials"] = len(rows)
+    manifest["status"] = "verifying" if len(rows) == manifest["planned_trials"] and not manifest["failures"] else "failed"
+    if manifest["status"] == "verifying":
+        manifest["replays"] = []
+        for original in (t for t in manifest["trials"] if t["tier"]=="hard" and t["seed"]==0 and t["policy"]=="blind"):
+            first = json.loads((Path(original["out"])/"result.json").read_text())
+            replay_dir = out/"replay"/original["scene"]
+            attempt = 1
+            while replay_dir.exists():
+                replay_dir = out/"replay"/f"{original['scene']}_attempt_{attempt}"
+                attempt += 1
+            repeated = {**original,"out":str(replay_dir)}
+            Path(repeated["out"]).mkdir(parents=True)
+            write_json(Path(repeated["out"])/"trial.json",repeated)
+            try:
+                again = launch_trial(repeated,native_python)
+                check = {"scene":original["scene"],**replay_check(first,again)}
+            except Exception as error:
+                check = {"scene":original["scene"],"passed":False,"error":str(error)}
+            manifest["replays"].append(check)
+            write_json(manifest_path,manifest)
+        if not all(r["passed"] for r in manifest["replays"]):
+            manifest["status"] = "replay_failed"
+            write_json(manifest_path,manifest)
+            return manifest
+        analysis = subprocess.run([sys.executable, str(ROOT / "scripts/e3_isaac_analysis.py"), str(out / "trials.csv"),
+                                   "--out", str(out / "analysis"), "--boot", "2000"], capture_output=True, text=True)
+        (out / "analysis.log").write_text(analysis.stdout+analysis.stderr, encoding="utf-8")
+        manifest["analysis"] = "complete" if analysis.returncode == 0 else "failed"
+        manifest["status"] = "failed" if analysis.returncode else "complete"
+    write_json(manifest_path, manifest)
+    return manifest
