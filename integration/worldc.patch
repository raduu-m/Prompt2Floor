@@ -0,0 +1,41 @@
+"""Prepare and run all selected E3 trials in Isaac Sim physics.
+
+    uv run python scripts/e3_isaac_suite.py prepare selection.json --out out/e3_isaac --seeds 10
+    uv run python scripts/e3_isaac_suite.py run out/e3_isaac --isaac-python /path/to/isaacsim/python.sh
+"""
+import argparse
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]/"src"))
+from worldc.e3.isaac_experiment import prepare, execute
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    modes = parser.add_subparsers(dest="mode", required=True)
+    prep = modes.add_parser("prepare")
+    prep.add_argument("selection", type=Path)
+    prep.add_argument("--out", type=Path, required=True)
+    prep.add_argument("--seeds", type=int, default=10)
+    prep.add_argument("--transform-seed",type=int,default=0,help="fixed geometry seed, separate from trial seeds; recorded in manifest")
+    run = modes.add_parser("run")
+    run.add_argument("out", type=Path)
+    run.add_argument("--isaac-python", type=Path, required=True)
+    run.add_argument("--resume",action="store_true",help="resume an interrupted campaign after verifying completed evidence and unchanged code")
+    run.add_argument("--allow-isaac-4.5", dest="allow_isaac_45", action="store_true", help="explicit older-engine backend; never changes the E1 runtime gate")
+    args = parser.parse_args()
+    try:
+        if args.mode == "prepare":
+            result = prepare(args.selection.resolve(), args.out.resolve(), args.seeds,args.transform_seed)
+            print(f"{result['status']}: {len(result['trials'])}/{result['planned_trials']} trial specifications")
+            return 0 if result["status"] == "prepared" else 1
+        result = execute(args.out.resolve(), args.isaac_python.resolve(), args.allow_isaac_45, args.resume)
+        print(f"{result['status']}: {result.get('completed_trials',0)}/{result['planned_trials']} physical trials")
+        return 0 if result["status"] == "complete" else 1
+    except Exception as error:
+        parser.exit(1,f"E3 Isaac: {type(error).__name__}: {error}\n")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/e3_isaac_analysis.py b/scripts/e3_isaac_analysis.py
new file mode 100644
index 0000000..171630c
--- /dev/null
+++ b/scripts/e3_isaac_analysis.py
@@ -0,0 +1,41 @@
+"""Analyze an unmixed Isaac E3 result set, including real PhysX contact metrics."""
+import sys
+from pathlib import Path
+import importlib.util
+
+import numpy as np
+
+spec = importlib.util.spec_from_file_location("e3_reference_analysis",Path(__file__).with_name("e3_analysis.py"))
+analysis = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(analysis)
+original_load = analysis.load
+
+
+def load(paths):
+    rows = original_load(paths)
+    if not rows or {r.get("backend") for r in rows}!={"isaac-physx-e3-v1"}:
+        raise ValueError("Isaac analysis requires only measured Isaac trials; do not mix 2D results")
+    if len({r["isaac_version"] for r in rows})!=1:
+        raise ValueError("Do not pool different Isaac engine versions")
+    return rows
+
+
+analysis.load = load
+analysis.METRICS.update({
+    "physx_contacts": (lambda r:r["physx_contact_episodes"],np.nanmean),
+    "physx_moving_contacts": (lambda r:r["physx_moving_contact_episodes"],np.nanmean),
+    "physx_success": (lambda r:float(r["physx_success"]),np.nanmean),
+    "physx_no_contact_success": (lambda r:float(r["physx_contact_free_success"]),np.nanmean),
+    "physics_failure": (lambda r:float(r["end"]=="physics_failure"),np.nanmean),
+})
+analysis.COLUMNS[:0] = [("PhysX moving episodes/trial","physx_moving_contacts",2,False),
+                      ("PhysX all episodes/trial","physx_contacts",2,False),
+                      ("PhysX success (%)","physx_success",0,True),
+                      ("PhysX no-contact success (%)","physx_no_contact_success",0,True),
+                      ("Physics failure (%)","physics_failure",0,True)]
+analysis.COLUMNS[:] = [("E3 geometric "+label if label in ("Moving coll./trial","All coll./trial","Success (%)","No-contact success (%)") else label,
+                       metric,digits,pct) for label,metric,digits,pct in analysis.COLUMNS]
+
+
+if __name__=="__main__":
+    analysis.main()
diff --git a/tests/test_e3_contact.py b/tests/test_e3_contact.py
